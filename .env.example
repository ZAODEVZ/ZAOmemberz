# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled connection string from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/zaomemberz?sslmode=require"

# ─── Session signing ────────────────────────────────────────────────────────
# 32+ byte random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── Sign-In-With-Ethereum / Farcaster ──────────────────────────────────────
# The domain end users authenticate against (no protocol). Used in SIWE/SIWF
# message verification to prevent phishing across domains.
NEXT_PUBLIC_AUTH_DOMAIN="localhost:3000"
# Full origin URL, used as the SIWE/SIWF message URI and AuthKit siweUri.
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# Optimism RPC endpoint used by Farcaster AuthKit to read the ID Registry
# contract during Sign-In-With-Farcaster verification. A public endpoint works;
# a dedicated one (Alchemy/Infura) is recommended for production.
NEXT_PUBLIC_OP_RPC_URL="https://mainnet.optimism.io"

# ─── ENS resolution ─────────────────────────────────────────────────────────
# Ethereum mainnet RPC used to resolve ENS names/avatars live. ENS lives on
# mainnet even though Respect lives on Optimism.
MAINNET_RPC_URL="https://eth.llamarpc.com"

# ─── Admin seeding key (optional) ───────────────────────────────────────────
# Raw API key used by scripts/admin tooling to write via the HTTP API.
# The hash of this is stored in the api_keys table (see `npm run keygen`).
ADMIN_API_KEY=""
